Algoritmo conversiontemperatura // by edison bonilla
	Definir temperaturaCentigrados, temperaturaFarenheit Como Real
	Escribir " ingrese la temperatura en grados centigrados "
	Leer temperaturaCentigrados
	temperaturaFarenheit <- ( temperaturaCentigrados * 5/9 ) + 32
	Escribir " la temperatura en grados farenheit es " temperaturaFarenheit
FinAlgoritmo