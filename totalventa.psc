Algoritmo totalventa // by edison bonilla
	Definir precioCamisa, totalDolares, tipoCambio, totalPesos Como Real
	Escribir " ingrese el precio de una camisa en dolares "
	Leer precioCamisa
	totalDolares <- precioCamisa * 5 
	Escribir " tipo de cambio de dolares a pesos "
	Leer tipoCambio
	totalPesos <- totalDolares * tipoCambio
	Escribir " el total de la venta en pesos es " totalPesos
FinAlgoritmo
